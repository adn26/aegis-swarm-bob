{
  "name": "aegis-swarm-backend",
  "version": "1.0.0",
  "description": "Aegis Swarm - Adversarial Multi-Agent Security Auditing System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=4096 server.js",
    "dev": "nodemon --max-old-space-size=4096 --ignore workspace/ --ignore logs/ server.js",
    "test": "node --max-old-space-size=4096 --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "db:init": "node src/db/init.js"
  },
  "keywords": [
    "security",
    "ai",
    "agents",
    "langgraph",
    "vulnerability-scanner"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^0.2.0",
    "@langchain/google-vertexai": "^2.1.30",
    "@langchain/langgraph": "^0.0.34",
    "@langchain/openai": "^0.0.28",
    "@octokit/rest": "^20.0.2",
    "@supabase/supabase-js": "^2.105.1",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.12.2",
    "pdfkit": "^0.14.0",
    "simple-git": "^3.22.0",
    "tar": "^6.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.3"
  }
